# Archivos del entorno de desarrollo: quedan en el repositorio pero fuera del
# ZIP que descarga la gente (GitHub → Download ZIP y git archive).
/docker              export-ignore
/docker-compose.yml  export-ignore
/Makefile            export-ignore
/.env.example        export-ignore
/.gitattributes      export-ignore
/.gitignore          export-ignore
/README.md           export-ignore
/docs                export-ignore
/.wordpress-org      export-ignore
/.github             export-ignore
/tests               export-ignore

# Las traducciones las sirve translate.wordpress.org: el .po y el .mo quedan en el
# repositorio para aportarlas allí, pero no van en el ZIP del plugin.
/languages/*.po      export-ignore
/languages/*.mo      export-ignore
